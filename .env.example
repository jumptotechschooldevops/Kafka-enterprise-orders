# ============================================================
# Kafka Enterprise Orders - Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# ============================================================

# --- Kafka (Local docker-compose) ---
KAFKA_BOOTSTRAP=kafka:9092

# --- Kafka (Confluent Cloud - overrides KAFKA_BOOTSTRAP) ---
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxx.us-east-2.aws.confluent.cloud:9092
CONFLUENT_API_KEY=your_api_key_here
CONFLUENT_API_SECRET=your_api_secret_here

# --- Couchbase ---
COUCHBASE_HOST=couchbase             # use hostname from cloud.couchbase.com for Capella
COUCHBASE_BUCKET=order_analytics
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=your_password_here

# --- Backend API ---
# Comma-separated list of valid API keys
API_KEYS=dev-key-change-me,another-key

# --- Producer ---
TOPIC_NAME=orders
SLEEP_SECONDS=2

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=change-me-in-prod
