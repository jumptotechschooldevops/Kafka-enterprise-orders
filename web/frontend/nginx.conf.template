user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;

    server {
        listen       80;
        server_name  _;

        root /usr/share/nginx/html;
        index index.html;

        # FRONTEND
        location / {
            try_files $uri $uri/ /index.html;
        }

        # BACKEND REVERSE PROXY
        # BACKEND_URL and BACKEND_API_KEY are injected at container startup via envsubst.
        # The API key is added server-side so the React bundle never contains it.
        #   local docker-compose: http://backend:8000
        #   EKS sidecar pod:      http://localhost:8000
        location /api/ {
            proxy_pass ${BACKEND_URL}/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-API-Key ${BACKEND_API_KEY};
        }
    }
}
